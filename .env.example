# Application
APP_PORT=8080
APP_EXPOSE_PORT=8081
APP_ENV=development
LOG_FORMAT=text
# Timezone platform (berlaku untuk semua user; dipakai untuk parse/format DATE,
# TIME, dan output TIMESTAMPTZ ke UI)
APP_TIMEZONE=Asia/Jakarta

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_EXPOSE_PORT=5433
DB_USER=sipon
DB_PASS=secret
DB_NAME=sipon
DB_SSLMODE=disable

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-very-long-random-string
JWT_ACCESS_TTL=1440
JWT_REFRESH_TTL=43200

# SMTP (Email)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sipon.dev

# Fonnte (SMS Gateway)
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Redis
REDIS_ADDR=redis:6379
REDIS_EXPOSE_PORT=6380

# RabbitMQ (Messaging Queue)
# WAJIB=true karena pipeline scheduler selalu memakai pola OUTBOX (Outbox Relay +
# Message Consumer) — tanpa RabbitMQ worker tidak bisa berjalan.
RABBITMQ_ENABLED=true
RABBITMQ_USER=sipon
RABBITMQ_PASSWORD=sipon
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_EXPOSE_PORT=5674
RABBITMQ_UI_PORT=15672
RABBITMQ_UI_EXPOSE_PORT=15674
# DSN diisi dari dalam container (via docker network)
RABBITMQ_DSN=amqp://sipon:sipon@rabbitmq:5672/
RABBITMQ_EXCHANGE=sipon.events
RABBITMQ_DLX_EXCHANGE=sipon.events.dlx
RABBITMQ_PREFETCH=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
# Retry delay bertingkat dalam detik (comma-separated)
RABBITMQ_RETRY_DELAYS=60,300,1800

# Rate Limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# MinIO (Object Storage)
MINIO_EXPOSE_PORT=9004
MINIO_CONSOLE_EXPOSE_PORT=9005
# Endpoint internal (dijangkau dari dalam container app, via docker network)
MINIO_ENDPOINT=minio:9000
# Endpoint publik (dijangkau browser/FE) — pakai IP LAN mesin ini kalau FE
# diakses dari device lain, bukan cuma dari browser di mesin yang sama
MINIO_PUBLIC_ENDPOINT=localhost:9004
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sipon-public
MINIO_PRIVATE_BUCKET=sipon-private
MINIO_USE_SSL=false
# SSL untuk koneksi internal (dari dalam container ke MinIO). Pisahkan dari
# MINIO_USE_SSL karena endpoint internal docker (minio:9000) biasanya HTTP
# meski endpoint publiknya HTTPS.
MINIO_INTERNAL_USE_SSL=false

# Fingerprint (Integrasi Absensi)
# Endpoint sandbox (simulasi mesin fingerprint palsu) hanya didaftarkan bila
# diaktifkan — di production biarkan false.
FINGERPRINT_SANDBOX_ENABLED=false

# Worker (Background Scheduler)
# WORKER_ENABLED=false untuk menonaktifkan semua scheduled job (dev/debug).
# WORKER_TICK_SECONDS adalah interval polling untuk mengecek job yang jatuh tempo.
# WORKER_LEASE_SECONDS adalah lama lease job saat diklaim (recovery crash).
#
# Pipeline selalu memakai pola OUTBOX (tidak ada mode direct): dispatcher hanya
# menulis event_outbox, eksekusi via Outbox Relay + Message Consumer. Karena itu
# WAJIB mengaktifkan RABBITMQ_ENABLED=true. Dua worker yang sama-sama outbox aman
# (FOR UPDATE SKIP LOCKED).
WORKER_ENABLED=true
WORKER_TICK_SECONDS=10
WORKER_LEASE_SECONDS=300
# Port HTTP health/metrics untuk proses worker (/healthz, /metrics)
WORKER_HEALTH_PORT=9090

# Migration
MIGRATIONS_DIR=migrations

# Google OAuth
# Client IDs untuk Google Sign-In (comma-separated untuk multiple environments)
# Contoh: "web-client-id.apps.googleusercontent.com,mobile-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_IDS=
