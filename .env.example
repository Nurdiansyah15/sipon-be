# Application
APP_PORT=8080
APP_ENV=development
LOG_FORMAT=text

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=sipon
DB_PASS=secret
DB_NAME=sipon
DB_SSLMODE=disable

# JWT
JWT_SECRET_KEY=change-me-in-production-use-a-very-long-random-string
JWT_ACCESS_TTL=1440
JWT_REFRESH_TTL=43200

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sipon.dev

# Fonnte (SMS Gateway)
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send

# Redis
REDIS_ADDR=localhost:6379

# Rate Limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# MinIO (Object Storage)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=sipon-public
MINIO_PRIVATE_BUCKET=sipon-private
MINIO_USE_SSL=false

# Migration
MIGRATIONS_DIR=migrations
